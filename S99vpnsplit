#!/bin/sh
# VPN Split Tunneling - runs after S05vpnclient

VPNCMD="/opt/bin/vpncmd"
IPSET_FILE="/opt/etc/russia.ipset"
SPLIT_SCRIPT="/opt/etc/vpn-split.sh"
VPN_IF="vpn_vpn"
ACCOUNT="conn1"

wait_for_interface() {
    local i=0
    while [ $i -lt 30 ]; do
        # Wait for interface AND IP assignment (SoftEther Bridge assigns IP via DHCP)
        ip addr show $VPN_IF 2>/dev/null | grep -q "inet " && return 0
        sleep 1
        i=$((i+1))
    done
    return 1
}

case "$1" in
  start)
    echo "Configuring VPN split tunneling..."
    # vpnclient already started by S05vpnclient
    sleep 2
    # Connect account (has saved credentials)
    $VPNCMD /CLIENT localhost /CMD AccountConnect $ACCOUNT >/dev/null 2>&1
    sleep 2
    echo "Waiting for VPN interface..."
    if ! wait_for_interface; then
        echo "ERROR: VPN interface did not appear after 30s"
        exit 1
    fi
    # Load ipset (ipset restore fails if set exists; use flush+grep workaround)
    if ipset list russia >/dev/null 2>&1; then
        ipset flush russia 2>/dev/null
        grep "^add " $IPSET_FILE | ipset restore -exist 2>/dev/null
    else
        ipset restore < $IPSET_FILE 2>/dev/null
    fi
    # Start split tunneling
    $SPLIT_SCRIPT start
    echo "VPN split tunneling is UP."
    ;;
  stop)
    echo "Removing split tunneling rules..."
    $SPLIT_SCRIPT stop
    ipset flush russia 2>/dev/null
    ipset destroy russia 2>/dev/null
    $VPNCMD /CLIENT localhost /CMD AccountDisconnect $ACCOUNT >/dev/null 2>&1
    echo "Split tunneling stopped."
    ;;
  restart)
    $0 stop
    sleep 2
    $0 start
    ;;
  status)
    $VPNCMD /CLIENT localhost /CMD AccountStatusGet $ACCOUNT 2>&1 | grep -E "Session Status|Server Name|Session Name"
    echo "---"
    $SPLIT_SCRIPT status
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|status}"
    exit 1
    ;;
esac
